# Environment for compose.yaml. Start with:
#   docker run --rm wl-embedded-wallet-vault:local node scripts/generate-secrets.mjs > .env
# then append the settings below. Details: docs/DEPLOYMENT.md#generate-secrets.

# Generated. These empty placeholders do not start anything.
MASTER_KEY=
MANIFEST_SIGNING_KEY=
VAULT_SERVICE_TOKEN=
POSTGRES_PASSWORD=

# Vault domain. It cannot change without every user re-enrolling. RP_ID is exactly the host of ORIGIN.
ORIGIN=https://vault.example.com
RP_ID=vault.example.com
# With the `tls` profile: the domain Caddy requests the certificate for.
VAULT_DOMAIN=vault.example.com

# Handoff tokens from your backend: its public JWKS and the exact `iss`. The `aud` is ORIGIN unless you set another.
HANDOFF_JWKS_URL=https://app.example.com/.well-known/jwks.json
HANDOFF_ISSUER=https://app.example.com

# Optional. Full list: docs/DEPLOYMENT.md#environment-variables.
# Additional restriction: only these app origins, even with a valid token. Unset, any origin with a valid token is accepted.
# ALLOWED_APP_ORIGINS=https://app.example.com
# HANDOFF_AUDIENCE=https://vault.example.com
# Without a JWKS, as an alternative to HANDOFF_JWKS_URL: an Ed25519 public key in hex.
# HANDOFF_PUBLIC_KEY=
# HANDOFF_JWKS_CACHE_SECONDS=300
# HANDOFF_JWKS_COOLDOWN_SECONDS=30
# HANDOFF_JWKS_MAX_STALE_SECONDS=3600
# Chains by chainId, on one line and between single quotes (docs/DEPLOYMENT.md#chain-configuration).
# AA_CHAINS='{"11155111":{"name":"Sepolia","rpcUrl":"https://...","bundlerUrl":"https://...","paymasterUrl":"https://...","paymasterHeaders":{"Authorization":"Bearer ..."},"paymasterContext":{"sponsorshipPolicyId":"..."}}}'
# Hosts allowed for an RPC URL that arrives in the token, comma-separated.
# RPC_ALLOWED_HOSTS=rpc.example.com
# Brand: with compose.yaml, mount your brand directory at /brand (see the commented example there) and set:
# VAULT_BRAND_DIR=/brand
# Overrides `name` in brand.json.
# VAULT_BRAND_NAME=Acme Wallet
# VAULT_PORT=3000
# DATABASE_POOL_SIZE=10
# Where the client address for rate limits comes from: socket (default: the peer-address preload, plus TRUSTED_PROXIES)
# or vercel (x-real-ip, set by the Vercel edge; only honoured inside a Vercel function, never with TRUSTED_PROXIES).
# CLIENT_IP_SOURCE=socket
# Reverse proxies whose X-Forwarded-For is trusted: addresses or CIDRs, comma-separated. Without it, every client is
# counted as the address that connects to the vault (your proxy's). With the `tls` profile, the compose network's subnet.
# TRUSTED_PROXIES=172.16.0.0/12
# Rate limits per scope over the defaults (60 s windows). Scopes: handoff, share-a, recovery-challenge,
# recovery-assertion, relink-nonce, relink, aa, s2s, enroll. Fields: ip, sub, windowSeconds.
# RATE_LIMITS='{"handoff":{"ip":30,"sub":10},"aa":{"ip":240,"sub":120,"windowSeconds":60}}'
# Share A releases per session and per user in each window.
# SHARE_A_WINDOW_SECONDS=3600
# SHARE_A_MAX_PER_SESSION=5
# SHARE_A_MAX_PER_USER=30
# Unexpired passkey recovery challenges at once, across all clients.
# RECOVERY_CHALLENGE_MAX_LIVE=1000
# Caps on a sponsored deployment (gas units; fees in wei). AA_CHAINS["<chainId>"].limits overrides them per chain.
# AA_MAX_VERIFICATION_GAS_LIMIT=3000000
# AA_MAX_CALL_GAS_LIMIT=500000
# AA_MAX_PRE_VERIFICATION_GAS=500000
# AA_MAX_PAYMASTER_VERIFICATION_GAS_LIMIT=500000
# AA_MAX_PAYMASTER_POST_OP_GAS_LIMIT=200000
# AA_MAX_FEE_PER_GAS=500000000000
# tip = max(node tip, bundler quote) x AA_PRIORITY_FEE_MULTIPLIER_PERCENT / 100;
# maxFeePerGas = max(node gas price x AA_FEE_MULTIPLIER_PERCENT / 100 + tip, bundler quote x AA_PRIORITY_FEE_MULTIPLIER_PERCENT / 100),
# capped by AA_MAX_FEE_PER_GAS. The bundler quote is pimlico_getUserOperationGasPrice, when the bundler has it. 100 to 1000.
# AA_FEE_MULTIPLIER_PERCENT=200
# AA_PRIORITY_FEE_MULTIPLIER_PERCENT=120
# How long a sent sponsored deployment blocks another for the same Safe.
# AA_DEPLOYMENT_RETRY_SECONDS=900
