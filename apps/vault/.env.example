# `pnpm setup:env`, run from the repo root, generates apps/vault/.env.local and examples/demo/.env.local.
# 32 bytes in hex. Simulates the KMS/HSM key.
MASTER_KEY=
# Ed25519 private key (32 bytes in hex) for signing manifests. The public key is derived from it.
MANIFEST_SIGNING_KEY=
# The integrator's JWKS with the public keys for its tokens. https; http only locally with ALLOW_INSECURE_LOCAL.
HANDOFF_JWKS_URL=http://app.localhost:3200/.well-known/jwks.json
# Exact `iss` of its tokens. Required.
HANDOFF_ISSUER=http://app.localhost:3200
# Exact `aud` of its tokens. Optional, defaults to ORIGIN.
HANDOFF_AUDIENCE=http://vault.localhost:3201
# Alternative if there is no JWKS: Ed25519 public key in hex. Exactly one of the two.
# HANDOFF_PUBLIC_KEY=
# Optional. Refresh interval, cooldown on an unknown `kid`, and maximum cache staleness if the JWKS does not respond.
# HANDOFF_JWKS_CACHE_SECONDS=300
# HANDOFF_JWKS_COOLDOWN_SECONDS=30
# HANDOFF_JWKS_MAX_STALE_SECONDS=3600
# Token for s2s calls. At least 32 characters.
VAULT_SERVICE_TOKEN=
# Optional. Additional restriction: the domain is authorized by the `origin` signed in the token.
# ALLOWED_APP_ORIGINS=http://app.localhost:3200
# Must be exactly the host of ORIGIN. Changing it makes every user's passkeys unusable.
RP_ID=vault.localhost
ORIGIN=http://vault.localhost:3201
# postgres://... in production. `sslmode` in the URL controls SSL (required on Vercel; Neon's URL already has
# sslmode=require&channel_binding=require, both honoured). sqlite:path only outside production.
DATABASE_URL=sqlite:data/vault.db
# Connections per replica. Optional, defaults to 10 (5 on Vercel, where idle connections are also closed after 5 s).
# DATABASE_POOL_SIZE=10
# Brand directory with brand.json (docs/BRANDING.md). Relative to apps/vault. Without it, the neutral brand is used.
# brands/wl is the project's own brand (the public demo); brands/example is the fictional one the e2e suites mount.
VAULT_BRAND_DIR=../../brands/wl
# Name shown in the UI and on the passkey. Overrides `name` in brand.json. Optional, defaults to "Vault".
# VAULT_BRAND_NAME=Vault
# Testing only: in production, allows http on local hosts and SQLite.
# ALLOW_INSECURE_LOCAL=1
# Allowed hosts for an RPC that arrives in the handoff token, comma-separated. HTTPS; HTTP only locally.
RPC_ALLOWED_HOSTS=127.0.0.1
# Per chainId: { name?, nativeCurrency?, rpcUrl?, bundlerUrl, bundlerHeaders?, paymasterUrl?, paymasterHeaders?,
# paymasterContext?, sponsorTransactions?, limits? }. Ready-made public testnet values: docs/DEPLOYMENT.md#public-testnets.
# An rpcUrl here overrides the one in the token: use it if it contains an API key. Server only.
# "sponsorTransactions": true (requires paymasterUrl) also sponsors transactions from deployed Safes. Warning: any user
# can then spend the paymaster's budget on calls; set spend limits in the paymaster's policy.
AA_CHAINS={}
# Where the client address for rate limits comes from: socket (default: the peer-address preload, plus TRUSTED_PROXIES)
# or vercel (x-real-ip, set by the Vercel edge; only honoured inside a Vercel function, never with TRUSTED_PROXIES).
# CLIENT_IP_SOURCE=socket
# Reverse proxies whose X-Forwarded-For is trusted: addresses or CIDRs, comma-separated. Without it, every client is
# counted as the address that connects to the vault (your proxy's).
# TRUSTED_PROXIES=172.16.0.0/12
# Rate limits per scope over the defaults (60 s windows). Scopes: handoff, share-a, recovery-challenge,
# recovery-assertion, relink-nonce, relink, aa, transaction, s2s, enroll. Fields: ip, sub, windowSeconds.
# RATE_LIMITS='{"handoff":{"ip":30,"sub":10},"aa":{"ip":240,"sub":120,"windowSeconds":60}}'
# Share A releases per session and per user in each window.
# SHARE_A_WINDOW_SECONDS=3600
# SHARE_A_MAX_PER_SESSION=5
# SHARE_A_MAX_PER_USER=30
# Unexpired passkey recovery challenges at once, across all clients.
# RECOVERY_CHALLENGE_MAX_LIVE=1000
# Caps on every deployment and transaction the server builds (gas units; fees in wei). AA_CHAINS["<chainId>"].limits overrides them per chain.
# AA_MAX_VERIFICATION_GAS_LIMIT=3000000
# AA_MAX_CALL_GAS_LIMIT=500000
# AA_MAX_PRE_VERIFICATION_GAS=500000
# AA_MAX_PAYMASTER_VERIFICATION_GAS_LIMIT=500000
# AA_MAX_PAYMASTER_POST_OP_GAS_LIMIT=200000
# AA_MAX_FEE_PER_GAS=500000000000
# tip = max(node tip, bundler quote) x AA_PRIORITY_FEE_MULTIPLIER_PERCENT / 100;
# maxFeePerGas = max(node gas price x AA_FEE_MULTIPLIER_PERCENT / 100 + tip, bundler quote x AA_PRIORITY_FEE_MULTIPLIER_PERCENT / 100),
# capped by AA_MAX_FEE_PER_GAS. The bundler quote is pimlico_getUserOperationGasPrice, when the bundler has it. 100 to 1000.
# AA_FEE_MULTIPLIER_PERCENT=200
# AA_PRIORITY_FEE_MULTIPLIER_PERCENT=120
# How long a sent sponsored deployment blocks another for the same Safe.
# AA_DEPLOYMENT_RETRY_SECONDS=900
