# `pnpm setup:env`, run from the repo root, generates apps/vault/.env.local and examples/demo/.env.local.
# Ed25519 private key (32 bytes, hex) that signs the handoff token.
DEMO_HANDOFF_PRIVATE_KEY=
# `kid` under which that key signs and is published at /.well-known/jwks.json.
DEMO_HANDOFF_KID=
# `iss` of a login shared by several apps: the same in all of them. Optional, defaults to ORIGIN.
# DEMO_HANDOFF_ISSUER=
# Public keys that stay published during a rotation: [{ "kid": "...", "publicKey": "<hex>" }]. Optional.
# DEMO_HANDOFF_PUBLISHED_KEYS=[]
# 32 bytes, hex. Encrypts the TOTP secrets of the demo login.
DEMO_TOTP_KEY=
VAULT_SERVICE_TOKEN=
VAULT_ORIGIN=http://vault.localhost:3201
ORIGIN=http://app.localhost:3200
# Database. Production (Vercel): Postgres, e.g. the Neon URL `postgres://user:password@host/db?sslmode=require`;
# required when VERCEL=1. Unset or empty: SQLite at DB_PATH (local development, tests).
# DATABASE_URL=
# Postgres connections per instance, 1 to 200. Optional, default 5.
# DATABASE_POOL_SIZE=5
DB_PATH=data/demo.db
# Per 60 s window, per client IP and, for the second factor, per user. Optional; each field overrides its default:
# register ip 10, login ip 20, totp ip 20 / user 10, totp-setup ip 20 / user 10. Invalid values fall back to the defaults.
# DEMO_RATE_LIMITS={"login":{"ip":20,"windowSeconds":60},"totp":{"ip":20,"user":10}}
# Chains in the selector. The RPC never leaves the server; explorerUrl (http(s), links /address/<addr> and /tx/<hash>)
# and nativeCurrency (symbol) are optional and shown in the browser, e.g.
# [{ "chainId": 11155111, "name": "Sepolia", "rpcUrl": "https://ethereum-sepolia-rpc.publicnode.com", "explorerUrl": "https://sepolia.etherscan.io", "nativeCurrency": "ETH" }]
DEMO_CHAINS=[]
